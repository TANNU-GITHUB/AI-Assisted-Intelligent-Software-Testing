# Primary LLM: NVIDIA NIM — https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Fallback LLM: local Ollama (no key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Auth (required for login / protected API routes)
JWT_SECRET=generate-a-long-random-secret-for-production
JWT_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# GitHub OAuth — https://github.com/settings/developers (OAuth Apps)
# Callback URL must match GITHUB_REDIRECT_URI. Scope requested: read:user repo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
