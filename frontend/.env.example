# Optional: semantic UI testing with Jev + Playwright (https://www.shipwithjev.com/builds/playwright-jev)
OPENROUTER_API_KEY=
# Alternative provider key supported by some Jev tooling:
TYPESAFE_API_KEY=

# Playwright E2E
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_PORT=3000
# When backend is running locally:
E2E_BACKEND_URL=http://127.0.0.1:8000
